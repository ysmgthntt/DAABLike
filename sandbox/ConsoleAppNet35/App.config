<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DataAccessTracingTestDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
    <!-- name は空文字にはできない。
    <add name="" connectionString="empty" providerName="emptyProvider" />
    -->
    <add name="empty" connectionString="empty" providerName="emptyProvider" />
  </connectionStrings>
</configuration>